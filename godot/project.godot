; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="너구리 만물상"
run/main_scene="res://main.tscn"

; ── 켤 때 뜨는 Godot 로고를 끈다 ──
; Godot은 무료·로열티 0이고 **로고를 지우는 것도 허락한다**(MIT 허가서).
; 유니티처럼 "만든 도구를 반드시 보여줘야 한다"는 조건이 없다.
;
; show_image=false 면 아무 그림도 안 뜨고 bg_color만 잠깐 보인다.
; 그 색을 마을 풀색으로 맞춰 뒀다 — 검정에서 초록으로 튀는 것보다
; 처음부터 그 색이면 '켜졌다'는 느낌만 남고 로고 자리가 안 보인다.
;
; 나중에 우리 그림을 넣으려면 image 에 파일을 대고 show_image 를 도로 켠다.
application/boot_splash/show_image=false
application/boot_splash/bg_color=Color(0.435, 0.506, 0.349, 1)
application/boot_splash/fullsize=false
application/boot_splash/use_filter=true
config/features=PackedStringArray("4.7", "GL Compatibility")
# 앱 아이콘. 없으면 아이폰 내보내기가 도중에 멈춘다.
config/icon="res://art/icon.png"

[input_devices]

; 손가락을 마우스처럼(폰), 마우스를 손가락처럼(컴퓨터) — 양쪽 다 켠다.
; 뒤엣것이 없으면 컴퓨터에서 마우스 끌기로 창(스크롤)이 안 밀린다(유저 지적).
pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=true

[display]

window/size/viewport_width=430
window/size/viewport_height=932
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
